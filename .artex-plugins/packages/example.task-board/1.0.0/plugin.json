{
  "id": "example.task-board",
  "name": "任务概览示例",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "独立 UI 插件包；演示导航、命令、面板和宿主能力调用。",
  "dependencies": [
    "artex.core"
  ],
  "permissions": [
    "host.tasks.list"
  ],
  "contributions": [
    {
      "point": "panel",
      "id": "board",
      "label": "任务概览插件",
      "renderer": "ui/index.html",
      "order": 100
    },
    {
      "point": "navigation",
      "id": "board-nav",
      "label": "任务概览插件",
      "target": "board",
      "order": 100
    },
    {
      "point": "command",
      "id": "board-command",
      "label": "打开任务概览插件",
      "command": "/task-board",
      "target": "board"
    }
  ]
}