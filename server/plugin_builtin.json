[
  {
    "id": "artex.core",
    "name": "工作台宿主",
    "version": "1.0.0",
    "apiVersion": 1,
    "required": true,
    "description": "基础布局、身份与插件管理保持可用。",
    "contributions": [
      {
        "point": "command",
        "id": "settings",
        "label": "打开设置",
        "command": "/settings",
        "target": "host.settings.general"
      },
      {
        "point": "command",
        "id": "plugins",
        "label": "插件管理",
        "command": "/plugins",
        "target": "host.settings.plugins"
      },
      {
        "point": "command",
        "id": "model",
        "label": "选择当前会话模型",
        "command": "/model",
        "target": "host.inference.model"
      },
      {
        "point": "command",
        "id": "effort",
        "label": "调整思考强度",
        "command": "/effort",
        "target": "host.inference.effort"
      }
    ]
  },
  {
    "id": "artex.files",
    "name": "文件工作区",
    "version": "1.0.0",
    "apiVersion": 1,
    "dependencies": [
      "artex.core"
    ],
    "contributions": [
      {
        "point": "panel",
        "id": "files",
        "label": "文件",
        "renderer": "builtin.files",
        "order": 10
      },
      {
        "point": "panel",
        "id": "file",
        "label": "文件预览",
        "renderer": "builtin.file",
        "hidden": true
      },
      {
        "point": "command",
        "id": "files",
        "label": "打开文件",
        "command": "/files",
        "target": "files"
      },
      {
        "point": "view",
        "id": "files",
        "label": "文件",
        "target": "files",
        "order": 10
      }
    ]
  },
  {
    "id": "artex.terminal",
    "name": "终端工作区",
    "version": "1.0.0",
    "apiVersion": 1,
    "dependencies": [
      "artex.core"
    ],
    "contributions": [
      {
        "point": "panel",
        "id": "terminal",
        "label": "终端",
        "renderer": "builtin.terminal",
        "multiple": true,
        "order": 20
      },
      {
        "point": "command",
        "id": "terminal",
        "label": "打开终端",
        "command": "/terminal",
        "target": "terminal"
      },
      {
        "point": "view",
        "id": "terminal",
        "label": "终端",
        "target": "terminal",
        "order": 20
      }
    ]
  },
  {
    "id": "artex.browser",
    "name": "浏览器工作区",
    "version": "1.0.0",
    "apiVersion": 1,
    "dependencies": [
      "artex.core"
    ],
    "contributions": [
      {
        "point": "panel",
        "id": "browser",
        "label": "浏览器",
        "renderer": "builtin.browser",
        "multiple": true,
        "order": 30
      },
      {
        "point": "command",
        "id": "browser",
        "label": "打开浏览器",
        "command": "/browser",
        "target": "browser"
      },
      {
        "point": "view",
        "id": "browser",
        "label": "浏览器",
        "target": "browser",
        "order": 30
